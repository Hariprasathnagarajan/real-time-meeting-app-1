# Local development uses file:local.db automatically when these are omitted.
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only for local seed/demo data; not an identity mechanism.
DEFAULT_USER_NAME=Meeting Host
DEFAULT_USER_EMAIL=host@example.com

# Phase 3 LiveKit SFU integration. Never expose the API key or secret to the browser.
LIVEKIT_URL=wss://your-livekit-host.example.com
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
NEXT_PUBLIC_USE_LIVEKIT=false
